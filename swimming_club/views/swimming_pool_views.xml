<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===== Swimming pool ===== -->

    <record id="view_swimming_pool_list" model="ir.ui.view">
        <field name="name">swimming.pool.list</field>
        <field name="model">swimming.pool</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="city"/>
                <field name="partner_id"/>
                <field name="lane_count"/>
            </list>
        </field>
    </record>

    <record id="view_swimming_pool_form" model="ir.ui.view">
        <field name="name">swimming.pool.form</field>
        <field name="model">swimming.pool</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. City Swimming Pool"/></h1>
                    </div>
                    <group>
                        <group>
                            <label for="street" string="Address"/>
                            <div class="o_address_format">
                                <field name="street" placeholder="Street..." class="o_address_street"/>
                                <field name="city" placeholder="City" class="o_address_city"/>
                                <field name="zip" placeholder="ZIP" class="o_address_zip"/>
                                <field name="country_id" placeholder="Country" class="o_address_country"
                                       options="{'no_open': True, 'no_create': True}"/>
                            </div>
                        </group>
                        <group>
                            <field name="partner_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Lanes" name="lanes">
                            <field name="lane_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_swimming_pool_search" model="ir.ui.view">
        <field name="name">swimming.pool.search</field>
        <field name="model">swimming.pool</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="city"/>
                <field name="partner_id"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_swimming_pool" model="ir.actions.act_window">
        <field name="name">Swimming Pools</field>
        <field name="res_model">swimming.pool</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ===== Swimming lane ===== -->

    <record id="view_swimming_lane_list" model="ir.ui.view">
        <field name="name">swimming.lane.list</field>
        <field name="model">swimming.lane</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="pool_id"/>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="view_swimming_lane_search" model="ir.ui.view">
        <field name="name">swimming.lane.search</field>
        <field name="model">swimming.lane</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="pool_id"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <filter string="Swimming Pool" name="group_pool" context="{'group_by': 'pool_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_swimming_lane" model="ir.actions.act_window">
        <field name="name">Swimming Lanes</field>
        <field name="res_model">swimming.lane</field>
        <field name="view_mode">list</field>
        <field name="context">{'search_default_group_pool': 1}</field>
    </record>

    <!-- ===== Menus ===== -->

    <menuitem id="menu_swimming_club_root"
              name="Swimming Club"
              sequence="25"
              groups="base.group_user"/>

    <menuitem id="menu_swimming_pool"
              action="action_swimming_pool"
              parent="menu_swimming_club_root"
              sequence="10"/>

    <menuitem id="menu_swimming_lane"
              action="action_swimming_lane"
              parent="menu_swimming_club_root"
              sequence="20"/>

</odoo>
